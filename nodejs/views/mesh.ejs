<%- include('top') %>
<script type="text/javascript">app.auth.forceLogin();</script>

<div class="container mt-4 mb-5">
	<div class="d-flex align-items-center justify-content-between mb-4">
		<div>
			<h3 class="mb-1"><i class="fa-solid fa-diagram-project text-primary me-2"></i>Site Network</h3>
			<p class="text-muted small mb-0">
				What this gateway is actually doing right now. Sites, devices and exits are
				configured in the <strong>directory</strong> — joining a directory is joining the mesh —
				and this page shows how that config landed on the wire.
			</p>
		</div>
		<button class="btn btn-sm btn-outline-secondary" onclick="reconcileMesh(this)">
			<i class="fa-solid fa-rotate me-1"></i> Re-apply now
		</button>
	</div>

	<div id="mesh-alerts"></div>

	<div class="card shadow-sm mb-4">
		<div class="card-header bg-dark text-light border-secondary">
			<i class="fa-solid fa-server me-2"></i>This Gateway
		</div>
		<div class="card-body">
			<div class="row g-3">
				<div class="col-md-3">
					<div class="p-3 border rounded bg-light dark-bg-subtle">
						<div class="text-muted small fw-semibold">SITE</div>
						<div class="fw-bold mt-1" id="mesh-site">Loading...</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="p-3 border rounded bg-light dark-bg-subtle">
						<div class="text-muted small fw-semibold">MESH ADDRESS</div>
						<div class="font-monospace fw-bold text-primary mt-1" id="mesh-address">—</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="p-3 border rounded bg-light dark-bg-subtle">
						<div class="text-muted small fw-semibold">WIREGUARD</div>
						<div class="fw-bold mt-1" id="mesh-mode">—</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="p-3 border rounded bg-light dark-bg-subtle">
						<div class="text-muted small fw-semibold">UPLINK</div>
						<div class="font-monospace fw-bold mt-1" id="mesh-wan">—</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-header"><i class="fa-solid fa-network-wired me-2"></i>Peer Sites</div>
		<div class="card-body p-0" id="mesh-sites-wrap"><div class="text-center py-4 text-muted">Loading...</div></div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-header"><i class="fa-solid fa-laptop me-2"></i>Devices at This Site</div>
		<div class="card-body p-0" id="mesh-clients-wrap"><div class="text-center py-4 text-muted">Loading...</div></div>
	</div>

	<div class="card shadow-sm mb-4">
		<div class="card-header"><i class="fa-solid fa-globe me-2"></i>Internet Exits</div>
		<div class="card-body p-0" id="mesh-exits-wrap"><div class="text-center py-4 text-muted">Loading...</div></div>
	</div>

	<div class="card shadow-sm">
		<div class="card-header"><i class="fa-solid fa-right-left me-2"></i>LAN Mapping</div>
		<div class="card-body p-0" id="mesh-netmap-wrap"><div class="text-center py-4 text-muted">Loading...</div></div>
	</div>
</div>

<%- include('bottom') %>
<script type="text/javascript">
function esc(s) {
	return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

$(document).ready(function(){ loadStatus(); });

function loadStatus() {
	app.api.get('mesh/status', function(err, data){
		if (err || !data) {
			$('#mesh-alerts').html('<div class="alert alert-danger">Could not read mesh status: ' + esc((err && err.message) || 'unknown error') + '</div>');
			return;
		}
		renderAlerts(data);
		renderSummary(data);
		renderSites(data);
		renderClients(data);
		renderExits(data);
		renderNetmaps(data);
	});
}

// The failure modes worth calling out explicitly, because each one looks
// identical to "working" in a plain peer table.
function renderAlerts(d) {
	var alerts = [];
	if (!d.siteId) {
		alerts.push(['warning', 'This gateway has no site id yet. Its site has not joined a directory, so there is no mesh to build.']);
	}
	if (d.stale) {
		alerts.push(['warning', 'The directory is unreachable — showing the last known good configuration' +
			(d.directoryError ? ' (' + esc(d.directoryError) + ')' : '') +
			'. Tunnels keep running; changes made in the directory will not appear until it is back.']);
	}
	if (d.siteId && d.live && !d.live.up) {
		alerts.push(['danger', 'The WireGuard interface is not up, so nothing can cross the mesh. Use <em>Re-apply now</em>.']);
	}
	if (!d.wanInterface) {
		alerts.push(['warning', 'No default route found, so this gateway cannot NAT traffic to the internet. Exits and full-tunnel clients will not work.']);
	}
	if (d.planned && d.planned.netmaps && d.planned.netmaps.length && !d.netmapAvailable) {
		alerts.push(['danger', 'A LAN mapping is configured but this kernel has no NETMAP target — the mapping cannot be applied.']);
	}
	// A device pointed at an exit that cannot be built keeps working, but with
	// local breakout instead of the exit its owner picked. Say so by name.
	(d.planned && d.planned.exitProblems || []).forEach(function(p){
		alerts.push(['warning', 'Device <code>' + esc(p.client) + '</code> is set to exit through site '
			+ esc(p.exitSiteId) + ', which cannot be used: ' + esc(p.reason)
			+ '. Its traffic is breaking out locally instead.']);
	});
	$('#mesh-alerts').html(alerts.map(function(a){
		return '<div class="alert alert-' + a[0] + ' small py-2">' + a[1] + '</div>';
	}).join(''));
}

function renderSummary(d) {
	var site = d.site || {};
	$('#mesh-site').html(d.siteId
		? esc(site.name || site.slug || ('site ' + d.siteId)) + ' <span class="badge bg-primary ms-1">' + esc(d.siteId) + '</span>'
		: '<span class="text-muted">not joined</span>');
	$('#mesh-address').text((d.planned.addresses || []).join('  ') || '—');
	$('#mesh-mode').html(d.kernelWireguard
		? '<span class="badge bg-success"><i class="fa-solid fa-microchip me-1"></i> In-kernel</span>'
		: '<span class="badge bg-warning text-dark"><i class="fa-solid fa-layer-group me-1"></i> Userspace</span>');
	$('#mesh-wan').text(d.wanInterface || 'none');
}

// Handshake age is the only honest answer to "is this tunnel up?" -- a peer
// can be perfectly configured and completely dead.
function tunnelBadge(status) {
	if (!status) return '<span class="badge text-bg-secondary" title="Not present on the WireGuard device">Not applied</span>';
	if (!status.latestHandshake) return '<span class="badge text-bg-warning" title="Configured but never handshaken">Never connected</span>';
	var age = status.handshakeAgeSeconds;
	if (age < 300) return '<span class="badge text-bg-success" title="Last handshake ' + age + 's ago">Up</span>';
	return '<span class="badge text-bg-danger" title="Last handshake ' + age + 's ago">Stale (' + Math.round(age / 60) + 'm)</span>';
}

function renderSites(d) {
	var sites = (d.planned.peers || []).filter(function(p){ return p.kind === 'site'; });
	if (!sites.length) {
		$('#mesh-sites-wrap').html('<div class="text-center py-4 text-muted">No peer sites.<br><small>Sites appear here once another site joins the same directory and its gateway publishes a public key.</small></div>');
		return;
	}
	var live = (d.live && d.live.peers) || {};
	var rows = sites.map(function(p){
		return '<tr>'
			+ '<td>' + esc(p.label) + '</td>'
			+ '<td>' + tunnelBadge(live[p.publicKey]) + '</td>'
			+ '<td><code class="small">' + esc((p.allowedIPs || []).join(', ')) + '</code></td>'
			+ '<td><code class="small text-primary">' + esc(p.endpoint || 'dials in') + '</code></td>'
			+ '<td><code class="small text-truncate d-inline-block" style="max-width:200px;" title="' + esc(p.publicKey) + '">' + esc(p.publicKey) + '</code></td>'
			+ '</tr>';
	}).join('');
	$('#mesh-sites-wrap').html('<div class="table-responsive"><table class="table table-striped mb-0 align-middle">'
		+ '<thead><tr><th>Site</th><th>Tunnel</th><th>Routes</th><th>Endpoint</th><th>Public Key</th></tr></thead>'
		+ '<tbody>' + rows + '</tbody></table></div>');
}

function renderClients(d) {
	var clients = (d.planned.peers || []).filter(function(p){ return p.kind === 'client'; });
	if (!clients.length) {
		$('#mesh-clients-wrap').html('<div class="text-center py-4 text-muted">No devices enrolled at this site.<br><small>Users enrol their own devices in the directory.</small></div>');
		return;
	}
	var live = (d.live && d.live.peers) || {};
	var rows = clients.map(function(p){
		return '<tr>'
			+ '<td>' + esc(p.label) + '</td>'
			+ '<td>' + tunnelBadge(live[p.publicKey]) + '</td>'
			+ '<td><code class="small">' + esc((p.allowedIPs || [])[0]) + '</code></td>'
			+ '<td>' + (p.exitSiteId
				? '<span class="badge text-bg-info">via site ' + esc(p.exitSiteId) + '</span>'
				: '<span class="text-muted small">local breakout</span>') + '</td>'
			+ '</tr>';
	}).join('');
	$('#mesh-clients-wrap').html('<div class="table-responsive"><table class="table table-striped mb-0 align-middle">'
		+ '<thead><tr><th>Device</th><th>Tunnel</th><th>Address</th><th>Exit</th></tr></thead>'
		+ '<tbody>' + rows + '</tbody></table></div>');
}

function renderExits(d) {
	var exits = (d.planned && d.planned.exits) || [];
	if (!exits.length) {
		$('#mesh-exits-wrap').html('<div class="text-center py-4 text-muted">No exits in use.'
			+ '<br><small>Each device that picks an exit gets one here. Exits are chosen per device in the directory.</small></div>');
		return;
	}
	var live = d.exitLive || {};
	var rules = (d.planned && d.planned.exitRules) || [];
	var rows = exits.map(function(e){
		var status = live[e.siteId];
		// Each exit interface has exactly one peer -- the exit gateway.
		var peerStatus = null;
		if (status && status.peers) {
			var keys = Object.keys(status.peers);
			if (keys.length) peerStatus = status.peers[keys[0]];
		}
		var count = rules.filter(function(r){ return r.exitSiteId === e.siteId; }).length;
		return '<tr>'
			+ '<td>' + esc(e.slug) + ' <span class="badge bg-primary ms-1">' + esc(e.siteId) + '</span></td>'
			+ '<td>' + (status ? tunnelBadge(peerStatus) : '<span class="badge text-bg-secondary">Not applied</span>') + '</td>'
			+ '<td><code class="small">' + esc(e.iface) + '</code></td>'
			+ '<td><code class="small text-primary">' + esc(e.endpoint) + '</code></td>'
			+ '<td>' + count + ' device' + (count === 1 ? '' : 's') + '</td>'
			+ '</tr>';
	}).join('');
	$('#mesh-exits-wrap').html('<div class="table-responsive"><table class="table table-striped mb-0 align-middle">'
		+ '<thead><tr><th>Exit site</th><th>Tunnel</th><th>Interface</th><th>Endpoint</th><th>In use by</th></tr></thead>'
		+ '<tbody>' + rows + '</tbody></table>'
		+ '<div class="p-3 small text-muted border-top">Each exit is a separate WireGuard interface, because only one peer per '
		+ 'interface can hold the default route. Devices are steered to one with a routing rule, so changing a device\'s exit '
		+ 'never changes its configuration.</div></div>');
}

function renderNetmaps(d) {
	var maps = d.planned.netmaps || [];
	if (!maps.length) {
		$('#mesh-netmap-wrap').html('<div class="text-center py-4 text-muted">No LAN mapping configured.'
			+ '<br><small>Set this site\'s LAN ranges in the directory to make local machines reachable from other sites.</small></div>');
		return;
	}
	var rows = maps.map(function(m){
		return '<tr><td><code class="small">' + esc(m.shadow) + '</code></td>'
			+ '<td class="text-muted"><i class="fa-solid fa-arrow-right-arrow-left"></i></td>'
			+ '<td><code class="small">' + esc(m.physical) + '</code></td></tr>';
	}).join('');
	$('#mesh-netmap-wrap').html('<div class="table-responsive"><table class="table table-striped mb-0 align-middle">'
		+ '<thead><tr><th>Reachable from the mesh as</th><th></th><th>Actually is</th></tr></thead>'
		+ '<tbody>' + rows + '</tbody></table>'
		+ '<div class="p-3 small text-muted border-top">Every site\'s LAN is likely 192.168.1.0/24, so each one is mapped 1:1 into its own range. '
		+ '10.x.168.53 is the machine at 192.168.1.53 here.</div></div>');
}

function reconcileMesh(btn) {
	var $btn = $(btn).prop('disabled', true);
	app.api.post('mesh/reconcile', {}, function(err, data){
		$btn.prop('disabled', false);
		if (err) return app.messages.toast('Re-apply failed: ' + err.message, 'danger');
		if (!data.ready) {
			app.messages.toast(data.reason || 'Nothing to apply', 'info');
		} else if (data.failed && data.failed.length) {
			app.messages.toast('Applied with ' + data.peers + ' peer(s); ' + data.failed.length + ' failed', 'warning');
		} else {
			app.messages.toast('Applied — ' + data.peers + ' peer(s)', 'success');
		}
		loadStatus();
	});
}
</script>
